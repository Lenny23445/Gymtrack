rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Plausibilitaets-Helfer fuer Zahlen, die in Level/Rangliste einfliessen.
    // get(key, default) faengt Felder ab, die der Privatsphaere-Filter gar nicht
    // erst schreibt; null ist erlaubt, weil das Profil stats/week bewusst leert.
    function okNum(v, max) { return v is number && v >= 0 && v <= max; }
    function okPeriod(p, maxSes, maxVol) {
      return p == null || (okNum(p.get('ses', 0), maxSes) && okNum(p.get('vol', 0), maxVol));
    }
    function okStats(s) {
      return s == null || (okNum(s.get('total', 0), 5000) && okNum(s.get('avgDur', 0), 1440));
    }
    // Post-Foto: base64-JPEG im Doc (kein Storage). Der Client drueckt die
    // Qualitaet bis unter 0,9 MB — darueber ist es kein App-Upload mehr.
    function okImg(v) { return v == null || (v is string && v.size() <= 1000000); }
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == "GMm3AlNn1pVRL6cc76opBgnM9sr1");
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'exercises','sessions','theme','companion','companionOn',
             'exFilterMode','wkFilterMode','statsFilterMode','welcomeShown',
             'lastSeenVersion','lastSeenBuild','updatedAt','_serverTime',
             'unitMode','weightHistory','trackerItems','trackerCounts',
             'customSplits','workoutPresets','planSplit','planMode','planGroups','planWeek',
             'streak','streakLastDate','notifEnabled','notifTime',
             'glass','adminUid','erfAchieved','weightGoal',
             'smartRestEnabled','smartRest',
             'heuteLayout','weekPlan','weightLog','weightStart','restTimerSecs',
             'onboarded','userName','obGoal','obExp','obFreq',
             'socialOn','friendCode','friends','gymName','gymLat','gymLng',
             'checkins','aiCoach','crewId',
             // _schemaV/flameBank schreibt der Client seit laengerem, standen aber
             // nie hier — er faengt die Ablehnung ueber CLOUD_NEUE_FELDER ab und
             // pusht dann OHNE sie (js/app-update.js, _setDocCompat). 'sesArc' ist
             // der Marker fuer das Einheiten-Archiv unten und laeuft ueber denselben
             // Rueckfall. Vor dem Publish also kein harter Schnitt, danach greifen
             // alle drei automatisch.
             '_schemaV','flameBank','sesArc'
           ])
        && (!('sessions'  in request.resource.data) || request.resource.data.sessions.size()  <= 5000)
        && (!('exercises' in request.resource.data) || request.resource.data.exercises.size() <= 500);
    }
    /* Einheiten-Archiv. Das Array 'sessions' oben liegt IM Nutzerdokument und
       damit unter dem 1-MiB-Limit von Firestore — bei rund 650 Byte je Einheit
       ist zwischen 1000 und 1400 Trainings Schluss, und danach geht gar kein
       Push mehr durch. Der Deckel von 5000 oben greift dafuer viel zu spaet.
       Hier steht deshalb ein Dokument je Einheit, ausgelagert aus dem Array.
       Die Einheit selbst liegt als JSON-Zeichenkette in 'j' und nicht als Map:
       so braucht ein neues Feld in der Einheit (Notiz, Satztyp, Herzfrequenz)
       KEINEN neuen Rules-Publish. Genau daran ist der Push am Eltern-Dokument
       schon mehrfach mit permission-denied gestorben — und ein abgelehnter
       Schreibvorgang heisst hier: die Einheit bleibt nur auf dem Geraet.
       Bewusst OHNE Founder-Ausnahme beim Lesen: das Eltern-Dokument oeffnet sich
       fuers Dashboard, der komplette Trainingsverlauf muss das nicht.
       Loeschen braucht der Eigentuemer selbst — fuer geloeschte Einheiten und
       fuer die Konto-Loeschung (Apple 5.1.1(v), Subcollections gehen beim
       Loeschen des Elterndokuments NICHT mit). */
    match /users/{userId}/sessions/{sid} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id','ts','j','v','u'])
        && request.resource.data.j is string
        && request.resource.data.j.size() <= 200000
        && request.resource.data.id == sid
        && okNum(request.resource.data.get('ts', 0), 99999999999999)
        && okNum(request.resource.data.get('v',  0), 1000);
    }
    // Coach-Dossier. BEWUSST OHNE Founder-Ausnahme, anders als das Eltern-Doc:
    // hier stehen gemeldete Einschraenkungen, also Gesundheitsangaben. Rules
    // kaskadieren nicht, die Subcollection braucht daher diesen eigenen Block.
    match /users/{userId}/coach/{docId} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && docId == 'dossier';
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && docId == 'dossier'
        && request.resource.data.keys().hasOnly([
             'v','goal','tone','limits','prefs','works','derived','coachStats','updatedAt'
           ])
        && (!('limits' in request.resource.data) || request.resource.data.limits.size() <= 8)
        && (!('prefs'  in request.resource.data) || request.resource.data.prefs.size()  <= 8)
        && (!('works'  in request.resource.data) || request.resource.data.works.size()  <= 8);
      allow delete: if request.auth != null && request.auth.uid == userId && docId == 'dossier';
    }
    match /profiles/{userId} {
      // Einzelabruf fuer jeden Angemeldeten (Freundesprofil, Feed-Autor, Karte).
      // Listen NUR mit Limit: Code-Suche fragt limit(1), Namenssuche limit(8),
      // Live-Zaehler limit(100). Eine Query ohne Limit waere ein Vollabzug der
      // Nutzerbasis inkl. gymLat/gymLng. Ausnahme: das Admin-Dashboard liest
      // profiles bewusst komplett (dashboard/index.html).
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && (request.auth.uid == "GMm3AlNn1pVRL6cc76opBgnM9sr1"
            || request.query.limit <= 100);
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'name','code','photo','gymName','gymLat','gymLng',
             'week','month','streak','lastWk','live','stats','friends','updatedAt',
             'pushToken','premium','about'
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && (!('friends' in request.resource.data) || request.resource.data.friends.size() <= 100)
        && okNum(request.resource.data.get('streak', 0), 1000)
        && okPeriod(request.resource.data.get('week',  null), 60,  5000000)
        && okPeriod(request.resource.data.get('month', null), 250, 20000000)
        && okStats(request.resource.data.get('stats', null));
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /activities/{aid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
               'type','name','ts','dur','mg','prs','week','streak','reactions'
             ])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 30
          && request.resource.data.ts is number
          && okNum(request.resource.data.get('dur', 0), 1440)
          && (!('prs' in request.resource.data) || request.resource.data.prs.size() <= 3)
          && (!('reactions' in request.resource.data) || request.resource.data.reactions.size() == 0);
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Fremd-Update nur auf reactions UND darin nur auf den eigenen Schluessel
        // (sonst liesse sich die ganze Map fremder Eintraege ueberschreiben).
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && ('reactions' in resource.data
                ? request.resource.data.reactions.diff(resource.data.reactions)
                    .affectedKeys().hasOnly([request.auth.uid])
                : request.resource.data.reactions.keys().hasOnly([request.auth.uid]));
      }

      match /posts/{pid} {
        allow read: if request.auth != null && (
          resource.data.visibility == 'public'
          || request.auth.uid == userId
          || get(/databases/$(database)/documents/profiles/$(userId)).data.friends.hasAny([request.auth.uid])
        );
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.visibility in ['friends','public']
          && request.resource.data.keys().hasOnly([
               'ts','visibility','img','imgPath','layout','dayName','dur','mgs','gym','name','photo','flames'
             ])
          && request.resource.data.dayName is string && request.resource.data.dayName.size() <= 60
          && request.resource.data.ts is number
          && okImg(request.resource.data.get('img', ''))
          && okNum(request.resource.data.get('dur', 0), 1440)
          && (!('mgs' in request.resource.data) || request.resource.data.mgs.size() <= 8)
          // Flammen sind die Punkte-Basis (_flameBankAdd) — ein Post startet bei 0,
          // sonst schreibt sich der Autor beim Anlegen selbst Reaktionen gut.
          && (!('flames' in request.resource.data) || request.resource.data.flames.size() == 0);
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Fremd-Update nur auf flames UND darin nur auf den eigenen Schluessel.
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flames'])
          && ('flames' in resource.data
                ? request.resource.data.flames.diff(resource.data.flames)
                    .affectedKeys().hasOnly([request.auth.uid])
                : request.resource.data.flames.keys().hasOnly([request.auth.uid]));
      }
    }
    // Community-Feed: collectionGroup('posts')-Query ueber ALLE Nutzer.
    // WICHTIG: Die verschachtelte Rule oben (match /profiles/{userId}/posts/{pid})
    // gilt NICHT fuer collectionGroup-Queries — dafuer verlangt Firestore eine
    // Recursive-Wildcard-Rule. Ohne die warf _cpgLoad() permission-denied ->
    // "Feed konnte nicht geladen werden". Nur oeffentliche Posts sind global lesbar;
    // friends-only bleibt ueber die nested Rule geschuetzt. Reads only — Schreiben/
    // Loeschen/flames-Update bleibt ausschliesslich in der nested posts-Rule (Autor).
    match /{path=**}/posts/{pid} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
    }
    match /reports/{rid} {
      allow create: if request.auth != null
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporter','authorUid','postId','kind','ts']);
      allow read: if request.auth != null && request.auth.uid == "GMm3AlNn1pVRL6cc76opBgnM9sr1";
    }
    match /requests/{rid} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid
            || request.auth.uid == "GMm3AlNn1pVRL6cc76opBgnM9sr1");
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from','to','fromName','fromCode','ts','status'])
        // Doc-ID ist fest 'from__to' (_reqId): pro Empfaenger genau ein Doc,
        // damit niemand die Collection mit Anfragen vollschreibt.
        && rid == request.resource.data.from + '__' + request.resource.data.to
        && request.resource.data.to is string
        && request.resource.data.ts is number
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 30;
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    /* Crews — gemeinsames Wochenziel (js/app-crew.js). Die Doc-ID IST der
       6-Zeichen-Beitrittscode, deshalb genuegt Lesen fuer jeden Angemeldeten:
       ohne den geteilten Code findet niemand ein Dokument (keine Suche, kein
       Index, nicht auflistbar).

       Der Rollover-Zweig ist BEWUSST lose: Rules koennen eine Aggregation ueber
       bis zu 20 Fremdwerte nicht nachrechnen. Die Vertrauensgrenze ist die
       eingeladene Crew. Der Zaehl-Zweig ist dagegen hart begrenzt — nur der
       eigene Feldpfad, Wert <= 7 (max. 1 Training je Kalendertag). */
    match /crews/{cid} {
      function isMember() { return resource.data.members.hasAny([request.auth.uid]); }
      function ch()       { return request.resource.data.diff(resource.data).affectedKeys(); }

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly([
             'name','owner','members','goal','weekKey','wk','streak','hist','createdAt','updatedAt'
           ])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.goal is int
        && request.resource.data.goal >= 3 && request.resource.data.goal <= 60;

      allow update: if request.auth != null && (
        // beitreten: genau die eigene uid dazu, max. 20 Mitglieder
        (ch().hasOnly(['members','updatedAt'])
          && !isMember() && request.resource.data.members.hasAny([request.auth.uid])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 20)
        // verlassen: nur sich selbst raus (inkl. eigenem Zaehlerstand)
        || (ch().hasOnly(['members','wk','updatedAt'])
          && isMember() && !request.resource.data.members.hasAny([request.auth.uid])
          && resource.data.members.hasAll(request.resource.data.members))
        // zaehlen: nur der eigene wk-Feldpfad, hart gedeckelt
        || (ch().hasOnly(['wk','weekKey','updatedAt']) && isMember()
          && request.resource.data.wk.diff(resource.data.wk).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.wk[request.auth.uid] is int
          && request.resource.data.wk[request.auth.uid] <= 7)
        // Rollover: nur bei echtem Wochenwechsel
        || (ch().hasOnly(['wk','weekKey','streak','hist','updatedAt']) && isMember()
          && request.resource.data.weekKey != resource.data.weekKey
          && request.resource.data.hist.size() <= 8)
        // Gruender: Name, Ziel, Mitglied entfernen
        || (ch().hasOnly(['name','goal','members','updatedAt'])
          && resource.data.owner == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.goal >= 3 && request.resource.data.goal <= 60)
      );

      // Aufloesen: der Gruender immer, das letzte verbleibende Mitglied auch
      // (sonst blieben verwaiste Crews stehen).
      allow delete: if request.auth != null
        && (resource.data.owner == request.auth.uid
            || (isMember() && resource.data.members.size() == 1));
    }
    match /admin/{docId} {
      allow read: if request.auth != null && request.auth.uid == "GMm3AlNn1pVRL6cc76opBgnM9sr1";
    }
    /* Lesen und Loeschen der EIGENEN Eintraege ist Pflicht, nicht Komfort:
       Apple Guideline 5.1.1(v) verlangt, dass die Konto-Loeschung wirklich alle
       Daten entfernt — dafuer muss der Client seine Eintraege erst finden. */
    match /analytics_users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == "GMm3AlNn1pVRL6cc76opBgnM9sr1");
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','firstSeen','lastSeen','totalSessions','totalSec','isAnon','isPremium','premPlan']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // Marketing-Content-Studio (gymtrack-marketing): geteilte Screenshot-Bibliothek
    // + geteilte Post-Datenbank. Jeder angemeldete (auch anonyme) Nutzer des Tools
    // liest/schreibt die gemeinsame Bibliothek — bewusst simpel, internes Tool.
    match /mkt_screenshots/{id} {
      allow read, write: if request.auth != null;
    }
    match /mkt_posts/{id} {
      allow read, write: if request.auth != null;
    }
    match /analytics_sessions/{sid} {
      allow read:   if request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.uid == "GMm3AlNn1pVRL6cc76opBgnM9sr1");
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','start','lastBeat','duration','isAnon'])
        && request.resource.data.duration is number
        && request.resource.data.isAnon is bool;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','start','lastBeat','duration','isAnon'])
        && request.resource.data.duration is number;
    }
  }
}
