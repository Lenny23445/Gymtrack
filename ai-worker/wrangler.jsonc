{
  // Deploy-Config für den KI-Worker. Enthält bewusst KEINE Secrets/API-Keys
  // (GEMINI_API_KEY etc. liegen als Cloudflare-Secrets im Dashboard, nicht hier).
  // `--keep-vars` ist obsolet: seit dem Umzug der Keys auf Secrets überschreibt ein
  // normaler `wrangler deploy` sie nicht mehr — der Flag galt nur, als die Keys noch
  // gewöhnliche `vars` waren. KV-Binding + öffentliche Vars sind hier reproduzierbar.
  "name": "gymtrack-ai",
  "main": "worker.js",
  "compatibility_date": "2026-07-23",
  "kv_namespaces": [
    { "binding": "AI_QUOTA", "id": "4ea529992cc548eb852b7e3b0818a03b" },
    // Referral (Einladungscodes, geschenkte Wochen, Trial-Kontingent). FEHLT das
    // Binding, gibt es keinen Trial — bewusst fail-closed, damit ein
    // Konfigurationsfehler nicht die KI für alle freischaltet.
    { "binding": "REF", "id": "c8f17210493c4760984c97e5ab9dc6aa" }
  ],
  "vars": {
    "MODEL": "gemini-3.5-flash-lite",
    "MONTHLY_LIMIT": "150",
    // ── Referral ──────────────────────────────────────────────────────────
    // Einlösungen JE CODE. Danach ist der Code tot, auch für Fremde: sonst
    // verschafft ein einziger öffentlich geposteter Code beliebig vielen
    // Fremden Gratis-Premium samt KI.
    "REF_MAX_REDEEMS": "2",
    // KI-Anfragen für die GESAMTE Gratiszeit (nicht pro Monat). Zahler haben
    // MONTHLY_LIMIT oben — die App stellt beide Zahlen im KI-Menü gegenüber.
    "TRIAL_LIMIT": "15",
    // Gemeinsamer Monatstopf ALLER Trial-Nutzer, getrennt vom Deckel der Zahler.
    // Eine Anfrage kostet 0,4–1 Cent, 15 Anfragen also 6–9 Cent je Testnutzer:
    // 20 $ reichen für rund 250–600 Trial-Nutzer im Monat. Ist der Topf leer,
    // bekommen nur Trials 429 — zahlende Nutzer merken davon nichts.
    "TRIAL_MONTHLY_USD": "20",
    // Kostendeckel wächst mit der Nutzerzahl mit: Deckel = Premium-Köpfe des
    // Monats × USD_PER_USER, mindestens MIN_MONTHLY_USD. Rechnung dahinter:
    // 2,99 € − 15 % Apple = 2,54 € ≈ 2,75 $ netto; 0,30 $ sind 11 % davon.
    // Ein Nutzer, der seine 150 Anfragen komplett ausreizt, kostet ~0,22 $.
    "USD_PER_USER": "0.30",
    // Sockel 25 (nicht 5): bei heutiger Nutzerzahl liegt Köpfe×0.30 NOCH UNTER dem
    // alten festen 25-$-Deckel — Break-even erst bei ~84 Köpfen. Mit Sockel 25 wird
    // der alte Deckel zur Untergrenze statt zur Obergrenze: nichts wird schlechter
    // als vorher, ab ~84 Köpfen wächst er wie geplant mit. Ohne diesen Sockel stünde
    // der Deckel direkt nach Deploy bei 5 $ gegen die im laufenden Monat schon
    // aufgelaufenen Kosten — jeder zahlende Nutzer bekäme sofort 429.
    "MIN_MONTHLY_USD": "25",
    // Bleibt als Not-Bremse: ist USD_PER_USER leer, gilt wieder dieser feste Wert.
    // Greift der Deckel (fest oder mitwachsend), antworten /chat|/coach|/analyze mit
    // 429 bis zum Monatswechsel — auch für das Founder-Konto, beim Testen im Blick behalten.
    "GLOBAL_MONTHLY_USD": "25"
  }
}
