{
  // Deploy-Config für den KI-Worker. Enthält bewusst KEINE Secrets/API-Keys
  // (GEMINI_API_KEY etc. bleiben Dashboard-Variablen und werden beim Deploy via
  // `--keep-vars` bewahrt). KV-Binding + öffentliche Vars sind hier reproduzierbar.
  "name": "gymtrack-ai",
  "main": "worker.js",
  "compatibility_date": "2026-07-23",
  "kv_namespaces": [
    { "binding": "AI_QUOTA", "id": "4ea529992cc548eb852b7e3b0818a03b" }
  ],
  "vars": {
    "MODEL": "gemini-3.5-flash-lite",
    "MONTHLY_LIMIT": "150",
    // Harter Kostendeckel/Monat über ALLE Nutzer. Rechnung: ~$0.002/Chat bei
    // Flash-Lite × 150 Anfragen = ~$0.30 pro voll ausgereiztem Premium-Nutzer.
    // 25 USD ≈ 80 Nutzer, die ihr Limit komplett ausschöpfen. Greift der Deckel,
    // antworten /chat|/coach|/analyze mit 429 bis zum Monatswechsel — auch für
    // das Founder-Konto, also beim Testen im Blick behalten.
    "GLOBAL_MONTHLY_USD": "25"
  }
}
